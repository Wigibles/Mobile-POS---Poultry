rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// Firestore security rules for Alyn's Poultry POS.
//
// IMPORTANT: These rules are NOT applied automatically. Deploy them from the
// Firebase console (Firestore Database → Rules → paste → Publish) or via the
// Firebase CLI (`firebase deploy --only firestore:rules`).
//
// This app currently has NO user authentication (firebase-auth is commented out
// in app/build.gradle.kts), so the rules below cannot key off request.auth.
// Two things protect your data instead:
//
//   1. App Check (already a dependency: firebase-appcheck-recaptcha).
//      Turn ON enforcement for Cloud Firestore in the Firebase console
//      (App Check → APIs → Cloud Firestore → Enforce). This ensures only
//      requests coming from your genuine app are accepted — it is the main
//      thing standing between your data and anyone who finds the API key.
//
//   2. The schema validation below, which rejects malformed writes so a bad
//      client can't corrupt documents your app then fails to parse.
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // Improved type checks to handle both integers and floating point numbers.
    function isNum(v)  { return v is int || v is float || v is number; }
    function isStr(v)  { return v is string; }

    match /products/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['id','name','category'])
                   && isNum(request.resource.data.id)
                   && isStr(request.resource.data.name)
                   && isStr(request.resource.data.category);
      allow update: if (!('name' in request.resource.data) || isStr(request.resource.data.name))
                   && (!('category' in request.resource.data) || isStr(request.resource.data.category));
      allow delete: if true;
    }

    match /product_variations/{id} {
      allow read: if true;
      allow write: if request.resource.data.keys().hasAll(['id','productId','name','price','multiplier'])
                   && isNum(request.resource.data.id)
                   && isNum(request.resource.data.productId)
                   && isStr(request.resource.data.name)
                   && isNum(request.resource.data.price)
                   && isNum(request.resource.data.multiplier);
      allow delete: if true;
    }

    match /categories/{id} {
      allow read: if true;
      allow write: if request.resource.data.keys().hasAll(['id','name'])
                   && isNum(request.resource.data.id)
                   && isStr(request.resource.data.name);
      allow delete: if true;
    }

    match /transactions/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['id','status','timestamp','totalAmount'])
                   && isNum(request.resource.data.id)
                   && isStr(request.resource.data.status)
                   && isNum(request.resource.data.timestamp)
                   && isNum(request.resource.data.totalAmount);
      // Allow updates to status (PAID/VOIDED). Timestamp check is kept for schema safety.
      allow update: if isStr(request.resource.data.status) && isNum(request.resource.data.timestamp);
      allow delete: if true;
    }

    match /transaction_items/{id} {
      allow read: if true;
      allow write: if request.resource.data.keys().hasAll(['id','transactionId','productId','quantity','multiplier'])
                   && isNum(request.resource.data.id)
                   && isNum(request.resource.data.transactionId)
                   && isNum(request.resource.data.productId)
                   && isNum(request.resource.data.quantity)
                   && isNum(request.resource.data.multiplier);
      allow delete: if true;
    }

    // Atomic ID counters — { value: <number> }.
    match /counters/{name} {
      allow read: if true;
      allow write: if isNum(request.resource.data.value);
      allow delete: if true;
    }

    match /cash_outs/{id} {
      allow read: if true;
      allow write: if request.resource.data.keys().hasAll(['id','amount','timestamp'])
                   && isNum(request.resource.data.id)
                   && (!('cashierName' in request.resource.data) || isStr(request.resource.data.cashierName))
                   && isNum(request.resource.data.amount)
                   && isNum(request.resource.data.timestamp);
      allow delete: if true;
    }

    match /borrows/{id} {
      allow read: if true;
      allow write: if request.resource.data.keys().hasAll(['id','borrowerName','amount','timestamp'])
                   && isNum(request.resource.data.id)
                   && isStr(request.resource.data.borrowerName)
                   && isNum(request.resource.data.amount)
                   && isNum(request.resource.data.timestamp);
      allow delete: if true;
    }

    match /operational_expenses/{id} {
      allow read: if true;
      allow write: if request.resource.data.keys().hasAll(['id','title','amount','timestamp'])
                   && isNum(request.resource.data.id)
                   && isStr(request.resource.data.title)
                   && isNum(request.resource.data.amount)
                   && isNum(request.resource.data.timestamp);
      allow delete: if true;
    }

    // Admin/Cashier login PINs.
    match /settings/{id} {
      allow read: if true;
      allow write: if request.resource.data.keys().hasAll(['adminPin','cashierPin'])
                   && isStr(request.resource.data.adminPin)
                   && isStr(request.resource.data.cashierPin);
      allow delete: if false;
    }
  }
}
